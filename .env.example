# Supabase project settings (Project Settings > API Keys in the Supabase dashboard).
# The publishable key is safe in the browser; row level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Public URL of the deployed app, used in invitation links and auth emails.
# Example: https://our-wedding-era.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000
